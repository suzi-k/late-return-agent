ELEVENLABS_API_KEY=
PHONE_NUMBER_ID=          # ElevenLabs phone number ID (Twilio number imported in the dashboard)
PUBLIC_URL=               # public URL of rental_api.py, e.g. your ngrok https URL
TOOL_TOKEN=               # long random string; the agent's tools send it to rental_api.py
REPORT_KEY=               # different random string; read-only key for /report?key=
WEBHOOK_SECRET=           # from ElevenLabs post-call webhook settings
BRANCH_PHONE=             # E.164 number that receives transfers, e.g. a second phone you own
DEMO_PHONE=               # your phone: calls.py --send only rings this number
LLM=gemini-2.5-flash
